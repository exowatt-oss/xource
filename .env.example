# PostgreSQL database; see README quickstart.
DATABASE_URL=postgresql+psycopg://xource:xource@localhost:5432/xource
# Absolute path on persistent storage recommended for deployment.
STORAGE_PATH=./data/blobs
APP_ENV=local
ENVIRONMENT=development
APP_BASE_URL=http://localhost:8000
# Local development ONLY: both variables explicitly disable authentication.
# Remove them in production; configure issuer, audience and allowed domains instead.
FORWARDED_AUTH_MODE=none
FORWARDED_AUTH_ALLOW_INSECURE_NONE_MODE=1
# Optional native document parsing; keep off unless you configure sandboxing.
DOCUMENT_PROCESSING_ENABLED=false
